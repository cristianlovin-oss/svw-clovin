      "conversation": [
        {
          "invocation_id": "inv-decision_fleet_85pct",
          "user_content": {
            "role": "user",
            "parts": [
              {
                "text": "Does the Southcentral plow fleet meet the 85% availability requirement for this storm?"
              }
            ]
          },
          "final_response": {
            "role": "model",
            "parts": [
              {
                "text": "Yes. 9 of 10 Southcentral units are available (in service, standby or fueling) = 90%, which meets the ADS-EM-200 requirement of at least 85%. ADS-PL-103 is out of service with a hydraulic line failure."
              }
            ]
          },
