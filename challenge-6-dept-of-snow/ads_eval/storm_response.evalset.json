    {
      "eval_id": "policy_p1_service_level",
      "conversation": [
        {
          "invocation_id": "inv-policy_p1_service_level",
          "user_content": {
            "role": "user",
            "parts": [
              {
                "text": "How quickly must ADS clear Priority 1 roads after the snow stops?"
              }
            ]
          },
          "final_response": {
            "role": "model",
            "parts": [
              {
                "text": "Priority 1 routes are plowed continuously during the storm and must have bare or wet pavement in all driving lanes within 4 hours after snowfall stops (ADS-OPS-100 section 2)."
              }
            ]
          },
          "intermediate_data": {
            "tool_uses": [
              {
                "name": "policy_agent",
                "args": {}
              }
            ],
            "intermediate_responses": []
          }
        }
      ],
      "session_input": {
        "app_name": "ads_agent",
        "user_id": "eval_user",
        "state": {
          "category": "policy"
        }
      }
    },
    {
      "eval_id": "policy_mailbox",
      "conversation": [
        {
          "invocation_id": "inv-policy_mailbox",
          "user_content": {
            "role": "user",
            "parts": [
              {
                "text": "A plow knocked over my mailbox. Will ADS pay for it?"
              }
            ]
          },
          "final_response": {
            "role": "model",
            "parts": [
              {
                "text": "ADS repairs or reimburses up to $75 for a standard mailbox, or $150 for a mailbox and post, only if it was installed to USPS standards and was physically hit by ADS equipment; damage from the weight of thrown snow is not covered. Mailbox damage is inspected within 5 business days (ADS-PUB-300)."
              }
            ]
          },
          "intermediate_data": {
            "tool_uses": [
              {
                "name": "policy_agent",
                "args": {}
              }
            ],
            "intermediate_responses": []
          }
        }
      ],
      "session_input": {
        "app_name": "ads_agent",
        "user_id": "eval_user",
        "state": {
          "category": "policy"
        }
      }
    },
    {
      "eval_id": "decision_storm_level_requirements",
      "conversation": [
        {
          "invocation_id": "inv-decision_storm_level_requirements",
          "user_content": {
            "role": "user",
            "parts": [
              {
                "text": "What storm level is Southcentral at, and what does that level require us to do?"
              }
            ]
          },
          "final_response": {
            "role": "model",
            "parts": [
              {
                "text": "Southcentral is at Level 3 (Winter Storm Kodiak, Blizzard Warning, declared 04:30 by the Storm Duty Officer). Level 3 requires activating the ADS EOC, all crews on 12-hour shifts, P3 and P4 routes may be suspended, coordination with State Troopers, storm briefings every 3 hours and public updates at least every 2 hours (ADS-EM-200)."
              }
            ]
          },
          "intermediate_data": {
            "tool_uses": [
              {
                "name": "operations_agent",
                "args": {}
              },
              {
                "name": "policy_agent",
                "args": {}
              }
            ],
            "intermediate_responses": []
          }
        }
      ],
      "session_input": {
        "app_name": "ads_agent",
        "user_id": "eval_user",
        "state": {
          "category": "decision"
        }
      }
    },
    {
      "eval_id": "decision_operator_hours",
      "conversation": [
        {
          "invocation_id": "inv-decision_operator_hours",
          "user_content": {
            "role": "user",
            "parts": [
              {
                "text": "The operator on ADS-PL-105 has 15 hours of plowing today. Can they keep going?"
              }
            ]
          },
          "final_response": {
            "role": "model",
            "parts": [
              {
                "text": "Only for about 1 more hour. ADS-PL-105 shows 15 hours today, and ADS-SAF-400 allows a maximum of 16 hours of equipment operation in any 24 hours, followed by at least 8 consecutive hours off; the operator should be relieved."
              }
            ]
          },
          "intermediate_data": {
            "tool_uses": [
              {
                "name": "operations_agent",
                "args": {}
              },
              {
                "name": "policy_agent",
                "args": {}
