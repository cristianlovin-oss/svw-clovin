GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global

# Models (served from the "global" location)
ADK_MODEL=gemini-3.6-flash
ADK_FALLBACK_MODELS=gemini-2.5-flash-lite,gemini-2.5-pro

# AI Applications datastores (printed by setup_cloud.py)
POLICY_DATASTORE_ID=projects/your-project-id/locations/global/collections/default_collection/dataStores/ads-policy-docs
OPS_DATASTORE_ID=projects/your-project-id/locations/global/collections/default_collection/dataStores/ads-operations-backend

# Google Maps Platform API key with Maps Grounding Lite enabled (keep it secret; restrict it to that API)
GOOGLE_MAPS_API_KEY=your-maps-api-key
