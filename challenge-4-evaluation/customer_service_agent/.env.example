# Vertex AI is required for the SAFETY metric (safety_v1 uses the Vertex Gen AI Evaluation Service).
# Run `gcloud auth application-default login` first.
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Model under test and judge model for the custom policy_grounded_factuality metric.
# (The rubric judge model is set in eval/eval_config.json.)
ADK_MODEL=gemini-2.5-flash
JUDGE_MODEL=gemini-2.5-flash

# Alternative without Google Cloud (SAFETY may not be available):
# GOOGLE_GENAI_USE_VERTEXAI=FALSE
# GOOGLE_API_KEY=your-api-key-here
# ADK_MODEL=gemini-3.5-flash
# JUDGE_MODEL=gemini-3.5-flash
