    {
      "eval_id": "acc_price_match_marketplace",
      "conversation": [
        {
          "invocation_id": "inv-acc_price_match_marketplace",
          "user_content": {
            "role": "user",
            "parts": [
              {
                "text": "A third-party seller on Amazon has the same tent for $40 less. Will you match it?"
              }
            ]
          },
          "final_response": {
            "role": "model",
            "parts": [
              {
                "text": "No. Price match does not cover marketplace sellers such as third-party sellers on Amazon. We match authorized US retailers on identical in-stock items within 14 days of purchase."
              }
            ]
          },
          "intermediate_data": {
            "tool_uses": [],
            "intermediate_responses": []
