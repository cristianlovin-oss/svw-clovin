          "final_response": {
            "role": "model",
            "parts": [
              {
                "text": "Summit-brand backpacks have a lifetime warranty against manufacturing defects, so a seam failure can be covered (normal wear and tear, misuse and accidents are not). Email photos and the order number to warranty@summittrail.example."
              }
            ]
          },
          "intermediate_data": {
            "tool_uses": [],
            "intermediate_responses": []
