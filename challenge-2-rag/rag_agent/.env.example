# Copy to rag_agent/.env and fill in your project ID.
# This agent runs on Vertex AI (needed for the AI Applications datastore).
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global

# Full resource path of the datastore; setup_datastore.py prints it.
DATASTORE_ID=projects/your-project-id/locations/global/collections/default_collection/dataStores/lumora-internal-docs

# Optional overrides
# ADK_MODEL=gemini-3.5-flash
# ADK_FALLBACK_MODELS=gemini-2.5-flash
# DATASTORE_SHORT_ID=lumora-internal-docs
# ENGINE_ID=lumora-internal-search
# GCS_BUCKET=your-project-id-lumora-corpus
